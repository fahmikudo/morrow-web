# =============================================================================
# morrow-web — production environment
#
# On the server this file is /opt/morrow-web/.env (chmod 600, never in git).
#   scp deploy/.env.example deploy@<server>:/opt/morrow-web/.env
#
# VITE_API_URL is NOT set here: it is inlined at build time by CI (the
# VITE_API_URL repository variable). Changing it needs a new release.
# =============================================================================

# Release — deploy.sh rewrites this on every release. To roll back, put the
# previous tag here (1.2.0 or sha-xxxxxxx from GHCR) and run `docker compose up -d`.
MORROW_WEB_IMAGE_TAG=

# Loopback port the host nginx proxies to. Must match the upstream in
# /etc/nginx/sites-available/<web-site>.conf.
APP_PORT=8082

TZ=Asia/Jakarta
